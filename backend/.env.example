# Comma-separated list of valid Admin passcodes. Any one of them grants the
# ADMIN role via POST /api/auth/token (see backend/src/auth.py). Support any
# number of entries — add or remove without a code change. Copy this file to
# backend/.env and replace with real values; backend/.env is gitignored.
ADMIN_PASSCODES=changeme-passcode-1,changeme-passcode-2

# Optional: overrides the default JWT signing key (backend/src/auth.py).
# JWT_SECRET_KEY=
